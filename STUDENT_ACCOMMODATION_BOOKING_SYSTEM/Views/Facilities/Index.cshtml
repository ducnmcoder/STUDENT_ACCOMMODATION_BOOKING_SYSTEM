@model STUDENT_ACCOMMODATION_BOOKING_SYSTEM.Models.Facilities.FacilitiesDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quản lý Cơ sở vật chất";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Student Accommodation Booking System</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Site CSS gốc và Wireframe CSS riêng cho Facilities Staff -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/facilities-wireframe.css" asp-append-version="true" />
</head>
<body class="wf-facilities-body">

    <!-- ==================== TOÀN CẢNH KHUNG GIAO DIỆN (APP SHELL) ==================== -->
    <div class="wf-app-shell">

        <!-- ==================== 1. LEFT RAIL (CỘT BIỂU TƯỢNG HẸP BÊN TRÁI) ==================== -->
        <aside class="wf-left-rail" aria-label="Điều hướng chính">
            <!-- Brand Logo Mark -->
            <a href="/facilities" class="wf-rail-brand" title="Hệ thống Quản lý Ký túc xá">
                <span>S</span>
            </a>

            <!-- Navigation Icons -->
            <nav class="wf-rail-nav">
                <!-- Icon Dashboard / Trang chủ -->
                <a href="/facilities" class="wf-rail-btn @(Model.ActiveTab == "assets" ? "active" : "")" title="Trang chủ / Thiết bị">
                    <span aria-hidden="true">🏠</span>
                </a>
                <!-- Icon Sự cố thiết bị -->
                <a href="/facilities?tab=incidents" class="wf-rail-btn @(Model.ActiveTab == "incidents" ? "active" : "")" title="Sự cố thiết bị">
                    <span aria-hidden="true">⚠</span>
                    @if (Model.Stats.PendingIncidents > 0)
                    {
                        <span class="wf-badge-dot" title="@Model.Stats.PendingIncidents sự cố chờ xử lý"></span>
                    }
                </a>
                <!-- Icon Nhật ký kiểm toán (Audit Log) -->
                <a href="/facilities?tab=logs" class="wf-rail-btn @(Model.ActiveTab == "logs" ? "active" : "")" title="Nhật ký AUDIT_LOG">
                    <span aria-hidden="true">📋</span>
                </a>
                <!-- Icon Hồ sơ cá nhân / Cài đặt -->
                <a href="/facilities-staff" class="wf-rail-btn" title="Hồ sơ nhân viên CSVC">
                    <span aria-hidden="true">⚙</span>
                </a>
            </nav>

            <!-- Bottom of Left Rail: Avatar & Logout -->
            <div class="wf-rail-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logout-form">
                    <button type="submit" class="wf-rail-btn" style="background:transparent; border:none; cursor:pointer;" title="Đăng xuất">
                        <span aria-hidden="true" style="color:#ef4444;">↪</span>
                    </button>
                </form>
                <a href="/facilities-staff" class="wf-rail-avatar" title="@Model.StaffName (@Model.EmployeeCode)">
                    @(string.IsNullOrEmpty(Model.StaffName) ? "F" : Model.StaffName.Substring(0, 1).ToUpper())
                </a>
            </div>
        </aside>

        <!-- ==================== 2. SIDEBAR (DANH SÁCH PHÒNG & BỘ LỌC PHỤ) ==================== -->
        <aside class="wf-sidebar" aria-label="Bộ lọc phòng">
            <div class="wf-sidebar-header">
                <h3>CƠ SỞ VẬT CHẤT</h3>
                <p>Danh mục phòng</p>
            </div>

            <!-- Lọc nhanh theo tòa nhà -->
            <div class="wf-sidebar-section">
                <div class="wf-section-title">TÒA NHÀ</div>
                <ul class="wf-room-list">
                    <li class="wf-room-item @(string.IsNullOrEmpty(Model.AssetFilter.Building) && !Model.AssetFilter.RoomId.HasValue ? "active" : "")">
                        <a href="/facilities?tab=@Model.ActiveTab">
                            <span>Tất cả tòa nhà</span>
                            <span class="wf-room-count">@Model.Stats.TotalAssets</span>
                        </a>
                    </li>
                    @foreach (var b in Model.Buildings)
                    {
                        var isActive = Model.AssetFilter.Building == b && !Model.AssetFilter.RoomId.HasValue;
                        var bCount = Model.Rooms.Where(r => r.Building == b).Sum(r => r.AssetCount);
                        <li class="wf-room-item @(isActive ? "active" : "")">
                            <a href="/facilities?tab=@Model.ActiveTab&building=@b">
                                <span>Tòa @b</span>
                                <span class="wf-room-count">@bCount</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Danh sách từng phòng cụ thể -->
            <div class="wf-sidebar-section">
                <div class="wf-section-title">PHÒNG HỌC / LƯU TRÚ</div>
                <ul class="wf-room-list">
                    @foreach (var r in Model.Rooms)
                    {
                        var isRoomActive = Model.AssetFilter.RoomId == r.RoomId;
                        <li class="wf-room-item @(isRoomActive ? "active" : "")">
                            <a href="/facilities?tab=@Model.ActiveTab&roomId=@r.RoomId" title="@r.DisplayText">
                                <span>Phòng @r.RoomCode</span>
                                <span class="wf-room-count">@r.AssetCount TB</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </aside>

        <!-- ==================== 3. MAIN CONTENT (KHU VỰC NỘI DUNG CHÍNH) ==================== -->
        <main class="wf-main-content">

            <!-- TABS CHUYỂN ĐỔI Ở ĐẦU MAIN CONTENT -->
            <div class="wf-tabs-container">
                <div class="wf-tabs-list">
                    <!-- Tab 1: Thiết bị phòng -->
                    <a href="/facilities?tab=assets@(Model.AssetFilter.RoomId.HasValue ? "&roomId=" + Model.AssetFilter.RoomId : "")" 
                       class="wf-tab-item @(Model.ActiveTab == "assets" ? "active" : "")">
                        <span>📦 Thiết bị phòng</span>
                        <span class="wf-tab-badge">@Model.Stats.TotalAssets</span>
                    </a>
                    <!-- Tab 2: Sự cố thiết bị -->
                    <a href="/facilities?tab=incidents" 
                       class="wf-tab-item @(Model.ActiveTab == "incidents" ? "active" : "")">
                        <span>⚠ Sự cố thiết bị</span>
                        <span class="wf-tab-badge @(Model.Stats.PendingIncidents > 0 ? "danger" : "")">
                            @Model.Stats.PendingIncidents mới
                        </span>
                    </a>
                    <!-- Tab 3: Nhật ký kiểm toán -->
                    <a href="/facilities?tab=logs" 
                       class="wf-tab-item @(Model.ActiveTab == "logs" ? "active" : "")">
                        <span>📋 Nhật ký AUDIT_LOG</span>
                    </a>
                </div>

                <!-- Thao tác nhanh chuyển về hồ sơ -->
                <div>
                    <a href="/facilities-staff" class="wf-btn-outline" style="font-size:0.8rem;">
                        👤 Hồ sơ của tôi
                    </a>
                </div>
            </div>

            <div class="wf-main-body">

                <!-- Thông báo TempData Success / Error -->
                @if (TempData["Success"] is string successMsg)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <strong>Thành công!</strong> @successMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string errorMsg)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Lưu ý:</strong> @errorMsg
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- ==================== TAB 1: THIẾT BỊ PHÒNG ==================== -->
                @if (Model.ActiveTab == "assets")
                {
                    <!-- Tiêu đề trang & Nút CTA Thêm thiết bị -->
                    <div class="wf-page-title-row">
                        <div>
                            <h1>Quản lý thiết bị theo phòng</h1>
                            <p>Theo dõi, thêm mới, sửa đổi thông tin và cập nhật tình trạng thiết bị ký túc xá.</p>
                        </div>
                        <div>
                            <button type="button" class="wf-btn-primary" data-bs-toggle="modal" data-bs-target="#createAssetModal">
                                ＋ Thêm thiết bị mới
                            </button>
                        </div>
                    </div>

                    <!-- Bộ lọc thiết bị (Filter bar) -->
                    <div class="wf-filter-card">
                        <form method="get" action="/facilities">
                            <input type="hidden" name="tab" value="assets" />
                            <div class="wf-filter-grid">
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">TÌM KIẾM</label>
                                    <input type="text" name="search" value="@Model.AssetFilter.Search" class="form-control" placeholder="Nhập mã tem, tên thiết bị..." />
                                </div>
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">PHÒNG</label>
                                    <select name="roomId" class="form-select">
                                        <option value="">-- Tất cả phòng --</option>
                                        @foreach (var r in Model.Rooms)
                                        {
                                            <option value="@r.RoomId" selected="@(Model.AssetFilter.RoomId == r.RoomId)">
                                                @r.DisplayText
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">TÌNH TRẠNG</label>
                                    <select name="condition" class="form-select">
                                        <option value="">-- Tất cả --</option>
                                        <option value="GOOD" selected="@(Model.AssetFilter.Condition == "GOOD")">Tốt (GOOD)</option>
                                        <option value="WORN" selected="@(Model.AssetFilter.Condition == "WORN")">Hao mòn (WORN)</option>
                                        <option value="DAMAGED" selected="@(Model.AssetFilter.Condition == "DAMAGED")">Hư hỏng (DAMAGED)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">TRẠNG THÁI</label>
                                    <select name="status" class="form-select">
                                        <option value="">-- Tất cả --</option>
                                        <option value="ACTIVE" selected="@(Model.AssetFilter.Status == "ACTIVE")">Đang dùng (ACTIVE)</option>
                                        <option value="MAINTENANCE" selected="@(Model.AssetFilter.Status == "MAINTENANCE")">Bảo trì (MAINTENANCE)</option>
                                        <option value="RETIRED" selected="@(Model.AssetFilter.Status == "RETIRED")">Thanh lý (RETIRED)</option>
                                        <option value="MISSING" selected="@(Model.AssetFilter.Status == "MISSING")">Thất lạc (MISSING)</option>
                                    </select>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="wf-btn-primary" style="padding: 7px 16px;">Lọc</button>
                                    <a href="/facilities?tab=assets" class="wf-btn-outline" style="padding: 7px 12px;" title="Xóa bộ lọc">✕</a>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Bảng danh sách thiết bị -->
                    <div class="wf-table-card">
                        <table class="wf-table">
                            <thead>
                                <tr>
                                    <th>MÃ TEM (TAG)</th>
                                    <th>TÊN THIẾT BỊ</th>
                                    <th>VỊ TRÍ PHÒNG</th>
                                    <th>TÌNH TRẠNG</th>
                                    <th>TRẠNG THÁI</th>
                                    <th>NGƯỜI TẠO / SỬA</th>
                                    <th style="text-align:right;">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AssetsPaged.Items.Any())
                                {
                                    @foreach (var asset in Model.AssetsPaged.Items)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="text-primary font-monospace">@asset.AssetTag</strong>
                                                @if (asset.IncidentCount > 0)
                                                {
                                                    <span class="badge bg-danger ms-1" title="@asset.IncidentCount sự cố liên quan">@asset.IncidentCount sự cố</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@asset.AssetName</strong>
                                            </td>
                                            <td>
                                                <span class="fw-bold">@asset.RoomCode</span> - @asset.Building (Tầng @asset.Floor)
                                            </td>
                                            <td>
                                                @if (asset.RegisteredCondition == "GOOD")
                                                {
                                                    <span class="wf-badge good">✓ Tốt</span>
                                                }
                                                else if (asset.RegisteredCondition == "WORN")
                                                {
                                                    <span class="wf-badge worn">⚠ Hao mòn</span>
                                                }
                                                else
                                                {
                                                    <span class="wf-badge damaged">✕ Hư hỏng</span>
                                                }
                                            </td>
                                            <td>
                                                @if (asset.AssetStatus == "ACTIVE")
                                                {
                                                    <span class="wf-badge active">● Đang hoạt động</span>
                                                }
                                                else if (asset.AssetStatus == "MAINTENANCE")
                                                {
                                                    <span class="wf-badge maintenance">🛠 Đang bảo trì</span>
                                                }
                                                else if (asset.AssetStatus == "RETIRED")
                                                {
                                                    <span class="wf-badge retired">⊘ Đã thanh lý</span>
                                                }
                                                else
                                                {
                                                    <span class="wf-badge missing">❓ Thất lạc</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    Tạo: @asset.CreatedByStaffName
                                                    @if (!string.IsNullOrEmpty(asset.UpdatedByStaffName))
                                                    {
                                                        <br /><span>Sửa: @asset.UpdatedByStaffName</span>
                                                    }
                                                </small>
                                            </td>
                                            <td style="text-align:right;">
                                                <div class="btn-group btn-group-sm">
                                                    <!-- Nút Đổi trạng thái nhanh -->
                                                    <button type="button" class="btn btn-outline-secondary" 
                                                            data-bs-toggle="modal" data-bs-target="#updateStatusModal"
                                                            data-asset-id="@asset.AssetId"
                                                            data-asset-tag="@asset.AssetTag"
                                                            data-asset-name="@asset.AssetName"
                                                            data-asset-condition="@asset.RegisteredCondition"
                                                            data-asset-status="@asset.AssetStatus"
                                                            title="Cập nhật tình trạng & trạng thái">
                                                        ⚙ Trạng thái
                                                    </button>
                                                    <!-- Nút Sửa thông tin -->
                                                    <button type="button" class="btn btn-outline-primary"
                                                            data-bs-toggle="modal" data-bs-target="#editAssetModal"
                                                            data-asset-id="@asset.AssetId"
                                                            data-asset-tag="@asset.AssetTag"
                                                            data-asset-name="@asset.AssetName"
                                                            data-room-id="@asset.RoomId"
                                                            data-asset-condition="@asset.RegisteredCondition"
                                                            data-asset-status="@asset.AssetStatus"
                                                            title="Sửa tên, phòng, tem">
                                                        ✎ Sửa
                                                    </button>
                                                    <!-- Nút Thanh lý / Xóa -->
                                                    <form asp-controller="Facilities" asp-action="RetireOrDeleteAsset" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn thanh lý / xóa thiết bị này?');">
                                                        <input type="hidden" name="assetId" value="@asset.AssetId" />
                                                        <button type="submit" class="btn btn-outline-danger" title="Thanh lý / Xóa">
                                                            🗑
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            Không tìm thấy thiết bị nào phù hợp với điều kiện tìm kiếm.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- Phân trang (Pagination) -->
                        @if (Model.AssetsPaged.TotalPages > 1)
                        {
                            <div class="wf-pagination">
                                <span>Trang @Model.AssetsPaged.PageIndex / @Model.AssetsPaged.TotalPages (Tổng cộng @Model.AssetsPaged.TotalItems thiết bị)</span>
                                <div class="wf-page-links">
                                    @if (Model.AssetsPaged.HasPreviousPage)
                                    {
                                        <a href="/facilities?tab=assets&page=@(Model.AssetsPaged.PageIndex - 1)&search=@Model.AssetFilter.Search&roomId=@Model.AssetFilter.RoomId&condition=@Model.AssetFilter.Condition&status=@Model.AssetFilter.Status" class="wf-page-btn">« Trước</a>
                                    }
                                    @for (var p = 1; p <= Model.AssetsPaged.TotalPages; p++)
                                    {
                                        <a href="/facilities?tab=assets&page=@p&search=@Model.AssetFilter.Search&roomId=@Model.AssetFilter.RoomId&condition=@Model.AssetFilter.Condition&status=@Model.AssetFilter.Status" 
                                           class="wf-page-btn @(p == Model.AssetsPaged.PageIndex ? "active" : "")">
                                            @p
                                        </a>
                                    }
                                    @if (Model.AssetsPaged.HasNextPage)
                                    {
                                        <a href="/facilities?tab=assets&page=@(Model.AssetsPaged.PageIndex + 1)&search=@Model.AssetFilter.Search&roomId=@Model.AssetFilter.RoomId&condition=@Model.AssetFilter.Condition&status=@Model.AssetFilter.Status" class="wf-page-btn">Sau »</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- ==================== TAB 2: SỰ CỐ THIẾT BỊ ==================== -->
                else if (Model.ActiveTab == "incidents")
                {
                    <div class="wf-page-title-row">
                        <div>
                            <h1>Sự cố thiết bị do bảo vệ báo cáo</h1>
                            <p>Tiếp nhận sự cố hỏng hóc/thất lạc từ biên bản kiểm tra phòng và cập nhật phương án xử lý bảo trì.</p>
                        </div>
                    </div>

                    <!-- Bộ lọc sự cố -->
                    <div class="wf-filter-card">
                        <form method="get" action="/facilities">
                            <input type="hidden" name="tab" value="incidents" />
                            <div class="wf-filter-grid">
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">TÌM KIẾM</label>
                                    <input type="text" name="search" value="@Model.IncidentFilter.Search" class="form-control" placeholder="Mã tem, thiết bị, ghi chú..." />
                                </div>
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">LOẠI SỰ CỐ</label>
                                    <select name="incidentType" class="form-select">
                                        <option value="">-- Tất cả loại sự cố --</option>
                                        <option value="DAMAGED" selected="@(Model.IncidentFilter.IncidentType == "DAMAGED")">Hư hỏng (DAMAGED)</option>
                                        <option value="MISSING" selected="@(Model.IncidentFilter.IncidentType == "MISSING")">Thất lạc (MISSING)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">DUYỆT ADMIN</label>
                                    <select name="reviewStatus" class="form-select">
                                        <option value="">-- Tất cả trạng thái duyệt --</option>
                                        <option value="PENDING" selected="@(Model.IncidentFilter.ReviewStatus == "PENDING")">Chờ Admin duyệt (PENDING)</option>
                                        <option value="CONFIRMED" selected="@(Model.IncidentFilter.ReviewStatus == "CONFIRMED")">Admin đã duyệt (CONFIRMED)</option>
                                        <option value="REJECTED" selected="@(Model.IncidentFilter.ReviewStatus == "REJECTED")">Admin từ chối (REJECTED)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label text-muted fw-bold" style="font-size:0.75rem;">PHÒNG</label>
                                    <select name="roomId" class="form-select">
                                        <option value="">-- Tất cả phòng --</option>
                                        @foreach (var r in Model.Rooms)
                                        {
                                            <option value="@r.RoomId" selected="@(Model.IncidentFilter.RoomId == r.RoomId)">@r.RoomCode - @r.Building</option>
                                        }
                                    </select>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="wf-btn-primary" style="padding: 7px 16px;">Lọc</button>
                                    <a href="/facilities?tab=incidents" class="wf-btn-outline" style="padding: 7px 12px;">✕</a>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Bảng danh sách sự cố -->
                    <div class="wf-table-card">
                        <table class="wf-table">
                            <thead>
                                <tr>
                                    <th>MÃ SỰ CỐ</th>
                                    <th>LOẠI SỰ CỐ</th>
                                    <th>THIẾT BỊ & PHÒNG</th>
                                    <th>THỜI GIAN BÁO</th>
                                    <th>BẢO VỆ GHI CHÚ</th>
                                    <th>DUYỆT ADMIN (NGƯỜI 4)</th>
                                    <th style="text-align:right;">XỬ LÝ KỸ THUẬT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.IncidentsPaged.Items.Any())
                                {
                                    @foreach (var inc in Model.IncidentsPaged.Items)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="font-monospace">#INC-@inc.IncidentId</strong>
                                                <div class="text-muted" style="font-size:0.74rem;">Biên bản @inc.Phase (BK #@inc.BookingId)</div>
                                            </td>
                                            <td>
                                                @if (inc.IncidentType == "DAMAGED")
                                                {
                                                    <span class="wf-badge damaged">🛠 Hư hỏng</span>
                                                }
                                                else
                                                {
                                                    <span class="wf-badge missing">❓ Thất lạc</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@inc.AssetName</strong>
                                                <div class="text-muted" style="font-size:0.78rem;">
                                                    Tem: <span class="font-monospace fw-bold text-dark">@inc.AssetTag</span> | Phòng @inc.RoomCode (@inc.Building)
                                                </div>
                                            </td>
                                            <td>
                                                @inc.ReportedAt.ToString("dd/MM/yyyy HH:mm")
                                                <div class="text-muted" style="font-size:0.74rem;">Bởi: @inc.GuardName</div>
                                            </td>
                                            <td>
                                                <span class="text-dark">@(string.IsNullOrWhiteSpace(inc.IncidentNotes) ? "Không có ghi chú thêm" : inc.IncidentNotes)</span>
                                            </td>
                                            <td>
                                                @if (inc.ReviewStatus == "PENDING")
                                                {
                                                    <span class="wf-badge pending">⏳ Chờ duyệt</span>
                                                }
                                                else if (inc.ReviewStatus == "CONFIRMED")
                                                {
                                                    <span class="wf-badge confirmed">✓ Đã duyệt (@(inc.VerifiedMissing ? "Xác nhận mất" : "Xác nhận hỏng"))</span>
                                                }
                                                else
                                                {
                                                    <span class="wf-badge rejected">✕ Từ chối</span>
                                                }
                                                @if (!string.IsNullOrEmpty(inc.AdminReviewerName))
                                                {
                                                    <div class="text-muted" style="font-size:0.72rem;">Duyệt bởi: @inc.AdminReviewerName</div>
                                                }
                                            </td>
                                            <td style="text-align:right;">
                                                <button type="button" class="wf-btn-primary" style="padding:6px 12px; font-size:0.8rem;"
                                                        data-bs-toggle="modal" data-bs-target="#processIncidentModal"
                                                        data-incident-id="@inc.IncidentId"
                                                        data-asset-id="@inc.AssetId"
                                                        data-asset-tag="@inc.AssetTag"
                                                        data-asset-name="@inc.AssetName"
                                                        data-incident-type="@inc.IncidentType"
                                                        data-current-status="@inc.CurrentAssetStatus"
                                                        data-current-condition="@inc.CurrentAssetCondition">
                                                    🛠 Xử lý bảo trì
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            Không có sự cố thiết bị nào được ghi nhận.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (Model.IncidentsPaged.TotalPages > 1)
                        {
                            <div class="wf-pagination">
                                <span>Trang @Model.IncidentsPaged.PageIndex / @Model.IncidentsPaged.TotalPages (Tổng cộng @Model.IncidentsPaged.TotalItems sự cố)</span>
                                <div class="wf-page-links">
                                    @for (var p = 1; p <= Model.IncidentsPaged.TotalPages; p++)
                                    {
                                        <a href="/facilities?tab=incidents&page=@p&search=@Model.IncidentFilter.Search&incidentType=@Model.IncidentFilter.IncidentType&reviewStatus=@Model.IncidentFilter.ReviewStatus" 
                                           class="wf-page-btn @(p == Model.IncidentsPaged.PageIndex ? "active" : "")">
                                            @p
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- ==================== TAB 3: NHẬT KÝ KIỂM TOÁN (AUDIT LOG) ==================== -->
                else if (Model.ActiveTab == "logs")
                {
                    <div class="wf-page-title-row">
                        <div>
                            <h1>Nhật ký kiểm toán thiết bị (AUDIT_LOG)</h1>
                            <p>Toàn bộ lịch sử thêm mới, điều chuyển phòng, cập nhật tình trạng và bảo trì thiết bị.</p>
                        </div>
                    </div>

                    <div class="wf-table-card">
                        <table class="wf-table">
                            <thead>
                                <tr>
                                    <th>MÃ LOG</th>
                                    <th>THỜI GIAN</th>
                                    <th>HÀNH ĐỘNG</th>
                                    <th>ĐỐI TƯỢNG (ASSET ID)</th>
                                    <th>NGƯỜI THỰC HIỆN</th>
                                    <th>TÓM TẮT THAY ĐỔI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentAuditLogs.Any())
                                {
                                    @foreach (var log in Model.RecentAuditLogs)
                                    {
                                        <tr>
                                            <td><span class="font-monospace">#LOG-@log.AuditId</span></td>
                                            <td>@log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>
                                                <span class="badge bg-secondary">@log.ActionType</span>
                                            </td>
                                            <td><strong class="font-monospace text-primary">#@log.TargetKey</strong></td>
                                            <td>@log.PerformedByName</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(log.BeforeSummary))
                                                {
                                                    <div class="text-muted" style="font-size:0.78rem;">Trước: @log.BeforeSummary</div>
                                                }
                                                <div class="fw-bold text-dark" style="font-size:0.82rem;">Sau: @log.AfterSummary</div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Chưa có bản ghi nhật ký kiểm toán nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </main>

        <!-- ==================== 4. RIGHT SIDE BAR (THỐNG KÊ & TÁC VỤ KHẨN) ==================== -->
        <aside class="wf-right-sidebar" aria-label="Thống kê nhanh">

            <!-- Widget 1: Thống kê tổng quan thiết bị -->
            <div class="wf-widget">
                <div class="wf-widget-title">
                    <span>📊 THỐNG KÊ THIẾT BỊ</span>
                </div>
                <div class="wf-stat-grid">
                    <div class="wf-stat-box">
                        <div class="wf-stat-num">@Model.Stats.TotalAssets</div>
                        <div class="wf-stat-label">Tổng thiết bị</div>
                    </div>
                    <div class="wf-stat-box">
                        <div class="wf-stat-num" style="color:#0d9488;">@Model.Stats.ActiveAssets</div>
                        <div class="wf-stat-label">Hoạt động</div>
                    </div>
                    <div class="wf-stat-box">
                        <div class="wf-stat-num" style="color:#ea580c;">@Model.Stats.MaintenanceAssets</div>
                        <div class="wf-stat-label">Bảo trì</div>
                    </div>
                    <div class="wf-stat-box">
                        <div class="wf-stat-num" style="color:#dc2626;">@Model.Stats.DamagedAssets</div>
                        <div class="wf-stat-label">Hư hỏng</div>
                    </div>
                </div>
            </div>

            <!-- Widget 2: Cảnh báo sự cố khẩn cấp -->
            <div class="wf-widget">
                <div class="wf-widget-title">
                    <span>⚠ CẢNH BÁO SỰ CỐ</span>
                    @if (Model.Stats.PendingIncidents > 0)
                    {
                        <span class="badge bg-danger">@Model.Stats.PendingIncidents Chờ</span>
                    }
                </div>
                @if (Model.Stats.PendingIncidents > 0)
                {
                    <div class="wf-alert-item">
                        <div class="wf-alert-title">
                            <span>Sự cố chưa xử lý</span>
                            <span>@Model.Stats.PendingIncidents</span>
                        </div>
                        <p class="mb-0 text-muted" style="font-size:0.78rem;">Có sự cố hư hỏng hoặc thất lạc do bảo vệ gửi lên cần nhân viên cơ sở vật chất kiểm tra.</p>
                        <a href="/facilities?tab=incidents" class="btn btn-sm btn-outline-danger mt-2 w-100" style="font-size:0.75rem;">
                            Kiểm tra sự cố ngay →
                        </a>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Hiện tại không có sự cố nào tồn đọng.</p>
                }
            </div>

            <!-- Widget 3: Thao tác nhanh -->
            <div class="wf-widget">
                <div class="wf-widget-title">
                    <span>⚡ THAO TÁC NHANH</span>
                </div>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm text-start" data-bs-toggle="modal" data-bs-target="#createAssetModal">
                        ＋ Thêm thiết bị vào phòng
                    </button>
                    <a href="/facilities?tab=assets&status=MAINTENANCE" class="btn btn-outline-secondary btn-sm text-start">
                        🛠 Xem thiết bị đang bảo trì (@Model.Stats.MaintenanceAssets)
                    </a>
                    <a href="/facilities?tab=assets&status=RETIRED" class="btn btn-outline-secondary btn-sm text-start">
                        ⊘ Xem thiết bị đã thanh lý (@Model.Stats.RetiredAssets)
                    </a>
                </div>
            </div>

            <!-- Widget 4: Thông tin nhân viên CSVC -->
            <div class="wf-widget" style="margin-top:auto;">
                <div class="wf-widget-title">
                    <span>👤 NHÂN VIÊN PHỤ TRÁCH</span>
                </div>
                <div class="small">
                    <div><strong>Họ và tên:</strong> @Model.StaffName</div>
                    <div><strong>Mã NV:</strong> @Model.EmployeeCode</div>
                    <div><strong>Khu vực:</strong> @Model.AssignedArea</div>
                    <div><strong>Bộ phận:</strong> @Model.Department</div>
                </div>
            </div>

        </aside>

    </div>

    <!-- ==================== 5. BOTTOM BAR (THANH TRẠNG THÁI HỆ THỐNG) ==================== -->
    <footer class="wf-bottom-bar" aria-label="Thanh trạng thái">
        <div>
            <span class="wf-status-indicator"></span>
            <span>Cơ sở dữ liệu: <strong>StudentAccommodationBookingDB</strong> | Kết nối: <strong>Ổn định</strong></span>
        </div>
        <div>
            <span>Đang hiển thị tab: <strong>@(Model.ActiveTab == "assets" ? "Thiết bị phòng" : (Model.ActiveTab == "incidents" ? "Sự cố thiết bị" : "Nhật ký kiểm toán"))</strong></span>
        </div>
        <div>
            <span>Tài khoản: <strong>@Model.StaffName</strong> | Vai trò: <strong>FACILITIES_STAFF</strong></span>
        </div>
    </footer>

    <!-- ==================== 6. MODALS POPUP ==================== -->

    <!-- Modal 1: Thêm mới thiết bị -->
