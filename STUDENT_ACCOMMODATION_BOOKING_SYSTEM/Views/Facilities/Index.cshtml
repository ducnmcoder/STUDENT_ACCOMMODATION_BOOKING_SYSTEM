                            <small class="text-muted">Mã tem là duy nhất trên toàn hệ thống.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên thiết bị <span class="text-danger">*</span></label>
                            <input type="text" name="AssetName" class="form-control" placeholder="Ví dụ: Bàn học gỗ, Ghế xoay, Điều hòa..." required maxlength="150" />
                        </div>
                        <div class="row g-2">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Tình trạng ban đầu</label>
                                <select name="RegisteredCondition" class="form-select">
                                    <option value="GOOD">Tốt (GOOD)</option>
                                    <option value="WORN">Hao mòn (WORN)</option>
                                    <option value="DAMAGED">Hư hỏng (DAMAGED)</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Trạng thái hoạt động</label>
                                <select name="AssetStatus" class="form-select">
                                    <option value="ACTIVE">Đang hoạt động</option>
                                    <option value="MAINTENANCE">Bảo trì</option>
                                    <option value="RETIRED">Thanh lý</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="wf-btn-primary">Lưu thiết bị</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 2: Chỉnh sửa thiết bị -->
    <div class="modal fade" id="editAssetModal" tabindex="-1" aria-labelledby="editAssetModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Facilities" asp-action="EditAsset" method="post">
                    <input type="hidden" name="AssetId" id="edit-asset-id" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="editAssetModalLabel">✎ Chỉnh sửa thông tin thiết bị</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Vị trí phòng</label>
                            <select name="RoomId" id="edit-room-id" class="form-select" required>
                                @foreach (var r in Model.Rooms)
                                {
                                    <option value="@r.RoomId">@r.DisplayText</option>
                                }
                            </select>
                            <small class="text-muted">Chọn phòng khác nếu cần luân chuyển thiết bị.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã tem thiết bị</label>
                            <input type="text" name="AssetTag" id="edit-asset-tag" class="form-control" required maxlength="50" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên thiết bị</label>
                            <input type="text" name="AssetName" id="edit-asset-name" class="form-control" required maxlength="150" />
                        </div>
                        <div class="row g-2">
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Tình trạng</label>
                                <select name="RegisteredCondition" id="edit-condition" class="form-select">
                                    <option value="GOOD">Tốt (GOOD)</option>
                                    <option value="WORN">Hao mòn (WORN)</option>
                                    <option value="DAMAGED">Hư hỏng (DAMAGED)</option>
                                </select>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label fw-bold">Trạng thái</label>
                                <select name="AssetStatus" id="edit-status" class="form-select">
                                    <option value="ACTIVE">Đang hoạt động</option>
                                    <option value="MAINTENANCE">Bảo trì</option>
                                    <option value="RETIRED">Thanh lý</option>
                                    <option value="MISSING">Thất lạc</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="wf-btn-primary">Cập nhật thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 3: Cập nhật nhanh tình trạng & trạng thái -->
    <div class="modal fade" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Facilities" asp-action="UpdateAssetStatus" method="post">
                    <input type="hidden" name="AssetId" id="status-asset-id" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="updateStatusModalLabel">⚙ Cập nhật tình trạng & trạng thái</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-muted">Thiết bị:</label>
                            <div class="fw-bold fs-6" id="status-asset-display"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tình trạng kỹ thuật</label>
                            <select name="RegisteredCondition" id="status-condition" class="form-select">
                                <option value="GOOD">Tốt (GOOD)</option>
                                <option value="WORN">Hao mòn (WORN)</option>
                                <option value="DAMAGED">Hư hỏng (DAMAGED)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Trạng thái hoạt động</label>
                            <select name="AssetStatus" id="status-status" class="form-select">
                                <option value="ACTIVE">● Đang hoạt động (ACTIVE)</option>
                                <option value="MAINTENANCE">🛠 Đưa vào bảo trì / sửa chữa (MAINTENANCE)</option>
                                <option value="RETIRED">⊘ Đã thanh lý / ngừng sử dụng (RETIRED)</option>
                                <option value="MISSING">❓ Báo mất / thất lạc (MISSING)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ghi chú xử lý</label>
                            <textarea name="Note" class="form-control" rows="2" placeholder="Nhập lý do thay đổi trạng thái hoặc biên bản kỹ thuật..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="wf-btn-primary">Lưu trạng thái</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 4: Xử lý sự cố kỹ thuật (Bảo dưỡng / Khắc phục) -->
    <div class="modal fade" id="processIncidentModal" tabindex="-1" aria-labelledby="processIncidentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Facilities" asp-action="ProcessIncident" method="post">
                    <input type="hidden" name="IncidentId" id="proc-incident-id" />
                    <input type="hidden" name="AssetId" id="proc-asset-id" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="processIncidentModalLabel">🛠 Xử lý sự cố kỹ thuật</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning mb-3">
                            <div class="fw-bold" id="proc-incident-title">Sự cố thiết bị</div>
                            <div class="small" id="proc-incident-desc"></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Phương án xử lý kỹ thuật</label>
                            <select name="Action" class="form-select" required>
                                <option value="MAINTENANCE">1. Tiếp nhận và đưa vào bảo dưỡng (MAINTENANCE)</option>
                                <option value="RESTORE">2. Đã sửa chữa / thay mới hoàn tất → Phục hồi hoạt động (ACTIVE)</option>
                                <option value="RETIRE">3. Hư hỏng hoàn toàn không thể sửa → Đề xuất thanh lý (RETIRED)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Cập nhật tình trạng thiết bị sau xử lý</label>
                            <select name="TargetCondition" class="form-select">
                                <option value="GOOD">Tốt (GOOD) - Sau sửa chữa hoặc thay thế</option>
                                <option value="WORN">Hao mòn (WORN)</option>
                                <option value="DAMAGED">Hư hỏng (DAMAGED) - Đang chờ linh kiện</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ghi chú giải pháp kỹ thuật</label>
                            <textarea name="MaintenanceNotes" class="form-control" rows="3" placeholder="Mô tả công việc: đã thay ốc ghế, hàn khung bàn, nạp ga điều hòa..."></textarea>
                        </div>
                        <div class="text-muted" style="font-size:0.75rem;">
                            * Lưu ý: Thao tác này sẽ cập nhật tình trạng thiết bị và tự động ghi vết vào bảng AUDIT_LOG. Quyết định duyệt bồi thường đối với sinh viên do Quản trị viên (Admin) phụ trách.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="wf-btn-primary">Ghi nhận xử lý</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts: Bootstrap 5 JS & Script gắn dữ liệu vào Modal -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modal Sửa thiết bị
        const editModal = document.getElementById('editAssetModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                document.getElementById('edit-asset-id').value = btn.getAttribute('data-asset-id');
                document.getElementById('edit-asset-tag').value = btn.getAttribute('data-asset-tag');
                document.getElementById('edit-asset-name').value = btn.getAttribute('data-asset-name');
                document.getElementById('edit-room-id').value = btn.getAttribute('data-room-id');
                document.getElementById('edit-condition').value = btn.getAttribute('data-asset-condition');
                document.getElementById('edit-status').value = btn.getAttribute('data-asset-status');
            });
        }

        // Modal Đổi trạng thái nhanh
        const statusModal = document.getElementById('updateStatusModal');
        if (statusModal) {
            statusModal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                const id = btn.getAttribute('data-asset-id');
                const tag = btn.getAttribute('data-asset-tag');
                const name = btn.getAttribute('data-asset-name');
                const cond = btn.getAttribute('data-asset-condition');
                const status = btn.getAttribute('data-asset-status');

                document.getElementById('status-asset-id').value = id;
                document.getElementById('status-asset-display').innerText = `${name} (Tem: ${tag})`;
                document.getElementById('status-condition').value = cond;
                document.getElementById('status-status').value = status;
            });
        }

        // Modal Xử lý sự cố
        const procModal = document.getElementById('processIncidentModal');
        if (procModal) {
            procModal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                const incId = btn.getAttribute('data-incident-id');
                const assetId = btn.getAttribute('data-asset-id');
                const tag = btn.getAttribute('data-asset-tag');
                const name = btn.getAttribute('data-asset-name');
                const type = btn.getAttribute('data-incident-type');
                const currentStatus = btn.getAttribute('data-current-status');

                document.getElementById('proc-incident-id').value = incId;
                document.getElementById('proc-asset-id').value = assetId;
                document.getElementById('proc-incident-title').innerText = `Sự cố #${incId}: ${type === 'DAMAGED' ? 'Hư hỏng' : 'Thất lạc'}`;
                document.getElementById('proc-incident-desc').innerText = `Thiết bị: ${name} (Mã tem: ${tag}) | Trạng thái hiện tại: ${currentStatus}`;
            });
        }
    </script>
</body>
</html>

