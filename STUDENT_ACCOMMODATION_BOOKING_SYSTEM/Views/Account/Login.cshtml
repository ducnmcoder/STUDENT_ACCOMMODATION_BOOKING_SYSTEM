@model STUDENT_ACCOMMODATION_BOOKING_SYSTEM.Models.LoginInput
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập | Student Accommodation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-intro">
            <div class="brand"><span class="brand-mark">S</span><span>STUDENT<br />ACCOMMODATION</span></div>
            <div class="auth-intro-copy">
                <span class="eyebrow">HỆ THỐNG QUẢN LÝ LƯU TRÚ</span>
                <h1>Một nơi để quản lý thông tin lưu trú của bạn.</h1>
                <p>Đăng nhập để truy cập không gian dành riêng cho vai trò của bạn.</p>
            </div>
            <div class="auth-intro-foot">Student Accommodation Booking System</div>
        </section>
        <section class="auth-form-side">
            <div class="auth-card">
                <div class="auth-mobile-brand"><span class="brand-mark">S</span> STUDENT ACCOMMODATION</div>
                <div class="eyebrow dark">CHÀO MỪNG TRỞ LẠI</div>
                <h2>Đăng nhập</h2>
                <p class="muted">Nhập tài khoản và mật khẩu để tiếp tục.</p>
                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
                    <div class="field-group">
                        <label asp-for="Email">Tài khoản</label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="username" placeholder="ten@vidu.com" required autofocus />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <button class="primary-button" type="submit">Đăng nhập <span aria-hidden="true">→</span></button>
                </form>
                <p class="auth-note">Sử dụng tài khoản đã được cấp trong hệ thống.</p>
            </div>
        </section>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
