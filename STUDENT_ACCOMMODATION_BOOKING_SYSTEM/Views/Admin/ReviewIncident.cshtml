@model dynamic
@{
    ViewData["Title"] = $"Duyệt sự cố #{Model.IncidentId}";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<header class="page-header">
    <div>
        <div class="eyebrow dark">QUẢN LÝ SỰ CỐ</div>
        <h1>🔍 Duyệt sự cố #@Model.IncidentId</h1>
        <p>Xem xét thông tin và quyết định xác nhận hoặc từ chối báo cáo</p>
    </div>
</header>

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Thông tin sự cố</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Mã sự cố</dt>
                            <dd class="col-sm-8"><code>#@Model.IncidentId</code></dd>

                            <dt class="col-sm-4">Loại sự cố</dt>
                            <dd class="col-sm-8">
                                @{
                                    string severity = Model.Severity;
                                    switch (severity)
                                    {
                                        case "MINOR":
                                            <span class="badge bg-info">Nhẹ</span>
                                            break;
                                        case "MODERATE":
                                            <span class="badge bg-warning">Trung Bình</span>
                                            break;
                                        case "SEVERE":
                                            <span class="badge bg-danger">Nghiêm Trọng</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@severity</span>
                                            break;
                                    }
                                }
                            </dd>

                            <dt class="col-sm-4">Tài sản</dt>
                            <dd class="col-sm-8"><strong>@Model.AssetType</strong></dd>

                            <dt class="col-sm-4">Phòng</dt>
                            <dd class="col-sm-8">@Model.RoomNumber</dd>

                            <dt class="col-sm-4">Người báo cáo</dt>
                            <dd class="col-sm-8">@Model.StudentName</dd>

                            <dt class="col-sm-4">Thời gian báo cáo</dt>
                            <dd class="col-sm-8">@Model.ReportedAt.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                            <dt class="col-sm-4">Booking ID</dt>
                            <dd class="col-sm-8">#@Model.BookingId</dd>

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <dt class="col-sm-4">Mô tả</dt>
                                <dd class="col-sm-8">@Model.Description</dd>
                            }
                        </dl>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Quyết định duyệt</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.ReviewStatus == "PENDING")
                        {
                            <form method="post" asp-action="ApproveIncident" asp-antiforgery="true" id="approveForm">
                                <input type="hidden" name="incidentId" value="@Model.IncidentId" />
                                
                                <div class="mb-4">
                                    <label class="form-label fw-bold">Quyết định <span class="text-danger">*</span></label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="decision" 
                                               id="approve" value="APPROVED" required />
                                        <label class="form-check-label" for="approve">
                                            <strong class="text-success">Chấp Nhận</strong> — Sự cố có thật
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="decision" 
                                               id="reject" value="REJECTED" required />
                                        <label class="form-check-label" for="reject">
                                            <strong class="text-danger">Từ Chối</strong> — Báo cáo không chính xác
                                        </label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="points" class="form-label">Điểm Uy Tín Bị Trừ</label>
                                    <input type="number" name="pointsDeducted" id="points" class="form-control" 
                                           min="0" max="100" value="0" />
                                    <small class="form-text text-muted">Nhập 0 nếu không trừ điểm</small>
                                </div>

                                <div class="mb-3">
                                    <label for="notes" class="form-label">Ghi chú của admin</label>
                                    <textarea name="adminNotes" id="notes" class="form-control" rows="4" 
                                              maxlength="300" placeholder="Nhập lý do và nhận xét..."></textarea>
                                    <small class="form-text text-muted">Tối đa 300 ký tự</small>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">✓ Xác nhận duyệt</button>
                                    <a asp-action="ManageIncidents" class="btn btn-outline-secondary">Hủy</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                Sự cố này đã được xử lý
                            </div>
                            @if (!string.IsNullOrEmpty(Model.AdminNotes))
                            {
                                <div class="mt-3">
                                    <strong>Ghi Chú Admin:</strong>
                                    <p class="mt-2">@Model.AdminNotes</p>
                                </div>
                            }
                            @if (Model.PointsDeducted > 0)
                            {
                                <div class="mt-3">
                                    <strong>Điểm Trừ:</strong> @Model.PointsDeducted
                                </div>
                            }
                            @if (Model.ReviewStatus == "CONFIRMED")
                            {
                                <div class="mt-3">
                                    <span class="badge bg-success">✓ Đã duyệt</span>
                                </div>
                            }
                            else if (Model.ReviewStatus == "REJECTED")
                            {
                                <div class="mt-3">
                                    <span class="badge bg-secondary">✗ Từ chối</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">💡 Lưu ý</h5>
                        <ul class="small mb-0">
                            <li><strong>CHẤP NHẬN:</strong> Nếu nhập điểm trừ, hệ thống sẽ tự động trừ điểm uy tín sinh viên.</li>
                            <li><strong>TỪ CHỐI:</strong> Không có hành động nào được thực hiện thêm.</li>
                            <li>Quyết định này không thể hoàn tác sau khi lưu.</li>
                            <li>Ghi chú của bạn sẽ được lưu vào cơ sở dữ liệu.</li>
                        </ul>
                    </div>
                </div>

                @{
                    if (Model.Severity == "SEVERE")
                    {
                        <div class="alert alert-warning mt-3">
                            <strong>⚠️ Cảnh báo</strong>
                            <br />
                            Đây là sự cố <strong>NGHIÊM TRỌNG</strong>. Xem xét kỹ trước khi duyệt.
                        </div>
                    }
                }
            </div>
        </div>

@section Scripts {
    <script>
        const form = document.getElementById('approveForm');
        if (form) {
            console.log('Form found:', form);
            form.addEventListener('submit', function(e) {
                console.log('Submit event triggered');
                const decision = document.querySelector('input[name="decision"]:checked');
                console.log('Selected decision:', decision?.value);
                
                if (!decision) {
                    e.preventDefault();
                    alert('Vui lòng chọn quyết định (Chấp nhận hoặc Từ chối)');
                    return false;
                }
                
                console.log('Form will submit with:', {
                    action: form.action,
                    method: form.method,
                    incidentId: document.querySelector('input[name="incidentId"]')?.value,
                    decision: decision.value,
                    points: document.getElementById('points')?.value
                });
                
                // Allow form to submit
                return true;
            });
        } else {
            console.error('Form with id approveForm not found!');
        }
    </script>
}
