@model ReputationViewModel
@{
    ViewData["Title"] = "Điểm uy tín";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><p class="text-uppercase text-secondary mb-1">STUDENT DASHBOARD</p><h1 class="h2">Điểm uy tín</h1><p class="text-secondary mb-0">Điểm theo tuần và lịch sử các lần cộng, trừ điểm.</p></div>
        <a class="btn btn-outline-primary" href="/student">Quay lại dashboard</a>
    </div>
    <section class="card shadow-sm mb-4"><div class="card-body">
        <h2 class="h5">Điểm theo tuần</h2>
        @if (Model.Weeks.Count == 0) { <p class="text-secondary mb-0">Chưa có dữ liệu điểm uy tín.</p> }
        else {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tuần bắt đầu</th><th>Điểm đầu tuần</th><th>Điểm hiện tại</th><th>Trạng thái đặt chỗ</th><th>Cập nhật lúc</th></tr></thead><tbody>
            @foreach (var week in Model.Weeks) { <tr><td>@week.WeekStart.ToString("dd/MM/yyyy")</td><td>@week.OpeningScore</td><td class="fw-semibold">@week.CurrentScore</td><td>@(week.BookingBlocked ? "Tạm khóa" : "Được phép")</td><td>@week.UpdatedAt.ToString("dd/MM/yyyy HH:mm") UTC</td></tr> }
            </tbody></table></div>
        }
    </div></section>
    <section class="card shadow-sm"><div class="card-body">
        <h2 class="h5">Lịch sử điểm</h2>
        @if (Model.Events.Count == 0) { <p class="text-secondary mb-0">Chưa có sự kiện điểm uy tín.</p> }
        else {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Thời gian</th><th>Tuần</th><th>Sự kiện</th><th>Thay đổi</th><th>Mã lý do</th><th>Ghi chú</th></tr></thead><tbody>
            @foreach (var item in Model.Events) { <tr><td>@item.OccurredAt.ToString("dd/MM/yyyy HH:mm") UTC</td><td>@item.WeekStart.ToString("dd/MM/yyyy")</td><td>@item.EventType</td><td class="@(item.ScoreDelta < 0 ? "text-danger" : "text-success") fw-semibold">@(item.ScoreDelta > 0 ? "+" : "")@item.ScoreDelta</td><td>@item.ReasonCode</td><td>@(item.Notes ?? "—")</td></tr> }
            </tbody></table></div>
        }
    </div></section>
</div>
