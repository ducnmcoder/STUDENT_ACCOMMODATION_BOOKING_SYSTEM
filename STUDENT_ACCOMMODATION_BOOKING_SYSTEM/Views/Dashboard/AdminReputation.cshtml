@model AdminReputationViewModel
@{
    ViewData["Title"] = "Lịch sử điểm";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><p class="text-uppercase text-secondary mb-1">ADMIN DASHBOARD</p><h1 class="h2">Lịch sử điểm</h1><p class="text-secondary mb-0">Tổng hợp điểm uy tín theo sinh viên và tuần.</p></div>
        <a class="btn btn-outline-primary" href="/admin">Quay lại dashboard</a>
    </div>
    <section class="card shadow-sm"><div class="card-body">
        @if (Model.Weeks.Count == 0) { <p class="text-secondary mb-0">Chưa có dữ liệu điểm uy tín.</p> }
        else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Sinh viên</th><th>Mã sinh viên</th><th>Tuần bắt đầu</th><th>Điểm hiện tại</th><th>Đặt chỗ</th></tr></thead><tbody>
            @foreach (var item in Model.Weeks) { <tr><td>@item.FullName</td><td>@item.StudentCode</td><td>@item.WeekStart.ToString("dd/MM/yyyy")</td><td class="fw-semibold">@item.CurrentScore</td><td>@(item.BookingBlocked ? "Tạm khóa" : "Được phép")</td></tr> }
        </tbody></table></div> }
    </div></section>
    <section class="card shadow-sm mt-4"><div class="card-body">
        <h2 class="h5">Các sự kiện điểm</h2>
        @if (Model.Events.Count == 0) { <p class="text-secondary mb-0">Chưa có sự kiện điểm uy tín.</p> }
        else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Thời gian</th><th>Sinh viên</th><th>Tuần</th><th>Sự kiện</th><th>Thay đổi</th><th>Mã lý do</th><th>Ghi chú</th></tr></thead><tbody>
            @foreach (var item in Model.Events) { <tr><td>@item.OccurredAt.ToString("dd/MM/yyyy HH:mm") UTC</td><td>@item.FullName (@item.StudentCode)</td><td>@item.WeekStart.ToString("dd/MM/yyyy")</td><td>@item.EventType</td><td class="@(item.ScoreDelta < 0 ? "text-danger" : "text-success") fw-semibold">@(item.ScoreDelta > 0 ? "+" : "")@item.ScoreDelta</td><td>@item.ReasonCode</td><td>@(item.Notes ?? "—")</td></tr> }
        </tbody></table></div> }
    </div></section>
</div>
